{
  "name": "@olivias/mcp-api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "sam build --template-file template.yaml",
    "lint": "eslint .",
    "test": "node --test test/*.test.mjs",
    "typecheck": "node -e \"console.log('mcp api typecheck: no TypeScript files')\"",
    "mcp:keys": "node scripts/keys.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-cloudformation": "~3.1034.0",
    "@aws-sdk/client-cognito-identity-provider": "~3.1030.0",
    "@aws-sdk/client-dynamodb": "~3.1034.0",
    "@aws-sdk/client-geo-places": "~3.1034.0",
    "@aws-sdk/client-lambda": "~3.1034.0",
    "@aws-sdk/lib-dynamodb": "~3.1034.0",
    "@modelcontextprotocol/server": "^2.4.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "eslint": "^9.20.1",
    "globals": "^15.14.0"
  }
}
