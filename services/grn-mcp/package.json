    "typecheck": "node -e \"console.log('grn mcp typecheck: no TypeScript files')\""
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.4.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "eslint": "^9.20.1",
    "globals": "^15.14.0",
    "js-yaml": "^4.1.0"
  }
}
