{
  "name": "@olivias/grn-mcp",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "sam build --template-file template.yaml",
    "generate": "node scripts/generate-operations.mjs",
